<!--packageStorage/pages/box-detail/box-detail.wxml-->
<wxs module="utils">
  function includes(arr, item) {
    return arr.indexOf(item) > -1;
  }
  module.exports = {
    includes: includes
  };
</wxs>
<view class="page-container">
  <!-- 自定义导航栏 -->
  <cu-custom bgColor="bg-white" isBack="{{true}}">
    <view slot="backText">返回</view>
    <view slot="content" class="nav-title">{{boxInfo.name || '箱子详情'}}</view>
    <view slot="right" class="nav-right">
      <text class="cuIcon-edit nav-icon" bindtap="onEditBox"></text>
    </view>
  </cu-custom>

  <!-- 搜索栏 -->
  <view class="search-container">
    <view class="search-box bg-white" bindtap="onSearch">
      <text class="cuIcon-search search-icon text-gray"></text>
      <input 
        class="search-input text-black" 
        placeholder="在此箱子中搜索袋子或物品" 
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
        confirm-type="search"
      />
    </view>
  </view>

  <!-- 主要内容区域 -->
  <view class="container">
    <!-- 骨架屏加载状态 -->
    <view wx:if="{{skeletonLoading}}" class="skeleton-container">
      <!-- 箱子信息骨架屏 -->
      <view class="skeleton-box-info">
        <view class="skeleton skeleton-avatar"></view>
        <view class="skeleton-content">
          <view class="skeleton skeleton-title"></view>
          <view class="skeleton skeleton-text" style="width: 80%;"></view>
          <view class="skeleton skeleton-text" style="width: 60%;"></view>
        </view>
      </view>
      
      <!-- 袋子列表骨架屏 -->
      <view wx:for="{{skeletonItems}}" wx:key="index" class="skeleton-item">
        <view class="skeleton-bag-item">
          <view class="skeleton skeleton-avatar"></view>
          <view class="skeleton-content">
            <view class="skeleton skeleton-title"></view>
            <view class="skeleton skeleton-text" style="width: 70%;"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 箱子信息和袋子列表 -->
    <view wx:else>
      <!-- 箱子信息卡片 -->
      <view class="box-info-card card">
        <view 
          class="box-preview"
          style="background: linear-gradient(135deg, {{boxInfo.color}} 0%, {{boxInfo.color}}88 100%)"
        >
          <view class="box-preview-content">
            <view class="box-preview-name">{{boxInfo.name}}</view>
            <view class="box-preview-desc" wx:if="{{boxInfo.description}}">{{boxInfo.description}}</view>
            <view class="box-preview-meta">
              <view class="box-preview-location" wx:if="{{boxInfo.location}}">
                <text class="cuIcon-locationfill"></text>
                <text>{{boxInfo.location}}</text>
              </view>
              <view class="box-preview-date">
                <text class="preview-date-text">{{boxInfo.createTime}}</text>
              </view>
            </view>
          </view>
          <!-- 编辑按钮 -->
          <view class="box-edit-btn" bindtap="onEditBox">
            <text class="cuIcon-edit"></text>
          </view>
        </view>
      </view>

      <!-- 统计信息 -->
      <view class="stats-card card bg-white">
        <view class="stats-content">
          <view class="stat-item">
            <text class="stat-number">{{boxInfo.totalBags}}</text>
            <text class="stat-label">袋子</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-number">{{boxInfo.totalItems}}</text>
            <text class="stat-label">物品</text>
          </view>
        </view>
      </view>

      <!-- 快速操作 -->
      <view class="quick-actions card bg-white">
        <view class="action-title text-black">快速操作</view>
          <view class="action-buttons">
          <view class="action-btn" bindtap="onAddBag">
            <view class="action-icon bg-blue">
              <text class="cuIcon-add"></text>
            </view>
            <text class="action-text text-gray">新建收纳袋</text>
          </view>
          <view class="action-btn" bindtap="onQuickScan">
            <view class="action-icon bg-green">
              <text class="cuIcon-camera"></text>
            </view>
            <text class="action-text text-gray">快速拍照</text>
          </view>
          <view class="action-btn" bindtap="onBatchMove">
            <view class="action-icon bg-orange">
              <text class="cuIcon-move"></text>
            </view>
            <text class="action-text text-gray">批量移动</text>
          </view>
          <view class="action-btn" bindtap="onDeleteBox">
            <view class="action-icon bg-red">
              <text class="cuIcon-delete"></text>
            </view>
            <text class="action-text text-gray">删除箱子</text>
          </view>
        </view>
      </view>



      <!-- 袋子列表 -->
      <view wx:if="{{bags.length > 0}}" class="bags-section">
        <view class="section-title">
          <text class="title-text">袋子列表</text>
          <text class="title-count">({{bags.length}})</text>
        </view>
        <!-- 批量工具栏（批量模式下显示） -->
        <view wx:if="{{batchModeBags}}" class="batch-toolbar">
          <view class="batch-left">
            <text class="batch-count">已选 {{selectedBagIds.length}}</text>
          </view>
          <view class="batch-actions">
            <button class="cu-btn line-blue sm" bindtap="onToggleSelectAll">{{selectAllChecked ? '全不选' : '全选'}}</button>
            <button class="cu-btn bg-blue lg" bindtap="onOpenMovePicker">选择目标位置</button>
          </view>
        </view>
        
        <view class="bags-list">
          <view 
            wx:for="{{bags}}" 
            wx:key="bag_id"
            class="bag-item"
            bindtap="onBagItemTap"
            data-id="{{item.bag_id}}"
          >
            <view class="bag-preview" style="background: {{item.color}}">
              <view class="bag-preview-info">
                <view class="bag-preview-name">{{item.name}}</view>
                <view class="bag-preview-count">{{item.itemCount}}件物品</view>
              </view>
              <view class="bag-menu" bindtap="onBagMenu" data-id="{{item.bag_id}}" catchtap="true">
                <text class="cuIcon-more"></text>
              </view>
              <!-- 选中遮罩层 (批量模式下显示) -->
              <view class="selection-overlay" wx:if="{{batchModeBags}}">
                <text class="selection-icon {{utils.includes(selectedBagIds, item.bag_id) ? 'cuIcon-roundcheckfill text-blue' : 'cuIcon-round text-white'}}"></text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:else class="empty-state">
        <text class="cuIcon-goods empty-icon"></text>
        <view class="empty-title">还没有袋子</view>
        <view class="empty-subtitle">点击按钮创建第一个收纳袋\n开始整理物品吧</view>
        <button class="cu-btn bg-blue margin-top" bindtap="onAddBag">
          <text class="cuIcon-add margin-right-xs"></text>
          创建第一个袋子
        </button>
      </view>
    </view>
  </view>

  <!-- 悬浮添加按钮 -->
  <view class="btn-fab" bindtap="onAddBag" wx:if="{{bags.length > 0}}">
    <text class="cuIcon-add"></text>
  </view>

  <!-- 袋子选择浮层 -->
  <view wx:if="{{showBagSelector}}" class="bag-selector-overlay" bindtap="onCloseBagSelector">
    <view class="bag-selector-modal" catchtap="">
      <view class="selector-header">
        <text class="selector-title">选择收纳袋</text>
        <text class="cuIcon-close selector-close" bindtap="onCloseBagSelector"></text>
      </view>
      
      <view class="selector-content">
        <view class="selector-subtitle">请选择一个收纳袋</view>
        
        <scroll-view class="selector-list" scroll-y="true">
          <view 
            wx:for="{{selectorBags}}" 
            wx:key="bag_id" 
            class="selector-bag-item"
            bindtap="onSelectBag"
            data-id="{{item.bag_id}}"
          >
            <view class="selector-bag-card">
              <view class="selector-bag-color" style="background-color: {{item.color}};"></view>
              <view class="selector-bag-info">
                <view class="selector-bag-single-line">
                  <view class="selector-bag-name">{{item.name}}</view>
                  <view class="selector-bag-count">{{item.itemCount || 0}}件</view>
                </view>
              </view>
              <view class="selector-bag-arrow">
                <text class="cuIcon-right"></text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 位置选择弹窗（批量移动目标，仅两层） -->
  <view class="location-picker-modal {{showMovePicker ? 'show' : ''}}" bindtap="onHideMovePicker" catchtouchmove="true">
    <view class="picker-content" catchtap="">
      <view class="picker-header">
        <text class="picker-title">选择目标位置</text>
        <view class="picker-close" bindtap="onHideMovePicker">
          <text class="cuIcon-close"></text>
        </view>
      </view>
      <scroll-view scroll-y class="picker-scroll">
        <!-- 1. 选择位置 -->
        <view class="picker-section">
          <text class="picker-section-title">位置</text>
          <view class="picker-tags">
            <view 
              wx:for="{{storageOptions.locations}}" 
              wx:key="*this" 
              class="picker-tag {{selectedLocation === item ? 'selected' : ''}}" 
              bindtap="onSelectLocation" 
              data-location="{{item}}"
            >
              {{item}}
            </view>
          </view>
        </view>
        <!-- 2. 选择收纳盒 -->
        <view class="picker-section" wx:if="{{filteredBoxes.length > 0}}">
          <text class="picker-section-title">收纳盒</text>
          <view class="picker-grid">
            <view 
              wx:for="{{filteredBoxes}}" 
              wx:key="id" 
              class="picker-card {{(selectedBox && (selectedBox.id || selectedBox.box_id)) === (item.id || item.box_id) ? 'selected' : ''}}" 
              bindtap="onSelectBox" 
              data-box="{{item}}"
            >
              <view class="picker-color-strip" style="background: {{item.color || '#1296db'}}"></view>
              <view class="picker-card-content">
                <view class="picker-card-title">{{item.name}}</view>
                <view class="picker-card-sub">{{item.location}}</view>
              </view>
              <view class="picker-check" wx:if="{{(selectedBox && (selectedBox.id || selectedBox.box_id)) === (item.id || item.box_id)}}">
                <text class="cuIcon-check"></text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="picker-footer safe-area-bottom">
        <button class="cu-btn bg-blue lg block" bindtap="onConfirmTargetBox" disabled="{{!selectedBox}}">确认移动到此处</button>
      </view>
    </view>
  </view>

  <!-- 批量移动进度弹窗 -->
  <view wx:if="{{movingProgress.running}}" class="progress-modal show">
    <view class="progress-content">
      <text class="progress-title">批量移动进行中</text>
      <view class="progress-bar">
        <view class="progress-bar-inner" style="width: {{movingProgress.percent}}%"></view>
      </view>
      <view class="progress-stats">
        <text>进度：{{movingProgress.processed}} / {{movingProgress.total}}（{{movingProgress.percent}}%）</text>
        <text>成功：{{movingProgress.success}}</text>
        <text>跳过：{{movingProgress.skipped}}</text>
        <text>失败：{{movingProgress.failed}}</text>
      </view>
    </view>
  </view>

  <!-- 结果汇总Modal（手动关闭） -->
  <view wx:if="{{showResultModal}}" class="result-modal show" bindtap="onCloseResultModal">
    <view class="result-content" catchtap="">
      <view class="result-header">
        <text class="result-title">批量移动完成</text>
      </view>
      <view class="result-body">
        <view class="result-row"><text>成功：</text><text>{{resultSummary.success}}</text></view>
        <view class="result-row"><text>跳过：</text><text>{{resultSummary.skipped}}</text></view>
        <view class="result-row"><text>失败：</text><text>{{resultSummary.failed}}</text></view>
      </view>
      <view class="result-footer">
        <button class="cu-btn bg-blue lg" bindtap="onCloseResultModal">我知道了</button>
      </view>
    </view>
  </view>
</view>
